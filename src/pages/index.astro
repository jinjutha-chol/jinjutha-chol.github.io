---
import Base from '../layouts/Base.astro'
import StatTile from '../components/StatTile.astro'
import ServiceCard from '../components/ServiceCard.astro'
import company from '../content/company.json'

type Service = {
  title: string
  icon: string
  summary: string
  highlights: string[]
  order: number
}

// Keystatic writes one flat JSON file per service. Globbing them keeps the page
// in sync automatically — add a service in the editor and it appears here.
const modules = import.meta.glob<Service>('../content/services/*.json', {
  eager: true,
  import: 'default',
})
const services = Object.values(modules).sort((a, b) => a.order - b.order)

const aboutParagraphs = company.about.split('\n').filter((p) => p.trim().length > 0)
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{company.tagline}</p>
      <h1 class="hero-title">{company.name}</h1>
      <p class="hero-intro">{company.intro}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#contact">Talk to us</a>
        <a class="btn btn-ghost" href="#services">See our services</a>
      </div>
    </div>
  </section>

  {
    company.stats.length > 0 && (
      <section class="wrap" aria-label="Key figures">
        <div class="stats">
          {company.stats.map((s) => (
            <StatTile value={s.value} label={s.label} />
          ))}
        </div>
      </section>
    )
  }

  <section class="section" id="services">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h2 class="section-title">Services</h2>
      <p class="section-lede">
        Engagements are scoped to the problem, not to a fixed package. Most clients start
        with one of these and grow from there.
      </p>
      <div class="grid">
        {
          services.map((s) => (
            <ServiceCard
              title={s.title}
              icon={s.icon}
              summary={s.summary}
              highlights={s.highlights}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section about" id="about">
    <div class="wrap about-grid">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2 class="section-title">About {company.name}</h2>
      </div>
      <div class="about-body">
        {aboutParagraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap">
      <div class="contact-card">
        <div>
          <p class="eyebrow">Get in touch</p>
          <h2 class="section-title">Let's talk about your project</h2>
          <p class="section-lede">
            Tell us what you're building or what's breaking. We'll tell you honestly whether
            we're the right team for it.
          </p>
        </div>
        <dl class="details">
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${company.contact.email}`}>{company.contact.email}</a></dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${company.contact.phone.replace(/\s+/g, '')}`}>{company.contact.phone}</a></dd>
          </div>
          <div>
            <dt>Office</dt>
            <dd>{company.contact.address}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(64px, 11vw, 112px) 40px;
    background:
      radial-gradient(60rem 26rem at 12% -10%, var(--accent-wash), transparent 65%);
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .hero-intro {
    margin-top: 20px;
    max-width: 60ch;
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
    color: var(--ink-secondary);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 20px;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--accent-solid);
    color: var(--on-accent);
  }

  .btn-primary:hover {
    filter: brightness(1.08);
  }

  .btn-ghost {
    border-color: var(--border);
    color: var(--ink);
    background: var(--surface);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }

  .grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .about {
    background: var(--surface-sunken);
    border-block: 1px solid var(--border);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 40px;
  }

  .about-body {
    display: grid;
    gap: 16px;
    color: var(--ink-secondary);
    font-size: 1.0625rem;
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .contact-card {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 40px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(28px, 5vw, 48px);
  }

  @media (max-width: 820px) {
    .contact-card {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .details {
    display: grid;
    gap: 20px;
    margin: 0;
    align-content: start;
  }

  .details dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .details dd {
    margin: 4px 0 0;
    font-size: 1rem;
    color: var(--ink);
  }
</style>
