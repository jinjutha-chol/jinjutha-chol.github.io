---
import Base from '../layouts/Base.astro'
import ServiceCard from '../components/ServiceCard.astro'
import DetailOverlay from '../components/DetailOverlay.astro'
import company from '../content/company.json'
import whoWeAre from '../content/who-we-are.json'
import pillars from '../content/pillars.json'
import privateEquity from '../content/private-equity.json'
import funds from '../content/funds.json'
import advisory from '../content/advisory.json'
import { appearance } from '../lib/appearance'

type Service = {
  title: string
  section?: 'lending' | 'advisory'
  icon: string
  summary: string
  description?: string
  regions?: string[]
  segments?: { name: string; examples: string[] }[]
  deals?: { client: string; summary: string }[]
  highlights: string[]
  order: number
}

// Keystatic writes one flat JSON file per service. Globbing keeps the page in
// sync automatically. The file name is the slug, so it doubles as the id for
// that service's detail overlay.
const slugFrom = (path: string) => path.split('/').pop()!.replace(/\.json$/, '')

const serviceModules = import.meta.glob<Service>('../content/services/*.json', {
  eager: true,
  import: 'default',
})
const allServices = Object.entries(serviceModules)
  .map(([path, data]) => ({ ...data, slug: slugFrom(path) }))
  .sort((a, b) => a.order - b.order)

// Anything not explicitly "advisory" belongs to the lending section.
const lendingServices = allServices.filter((s) => s.section !== 'advisory')
const advisoryServices = allServices.filter((s) => s.section === 'advisory')

const paragraphs = (text: string | undefined) =>
  (text ?? '').split('\n').map((p) => p.trim()).filter((p) => p.length > 0)

// The List layout is the only one that uses the full-width row form.
const cardVariant = appearance.layout === 'list' ? 'row' : 'card'

const SECTION_IDS = {
  privateEquity: 'private-equity-investments',
  privateLending: 'private-lending-solutions',
  funds: 'funds-investments',
}

// The three boxes. Display order is PE, Lending, Funds; the emphasised one is
// shown wider.
const pillarBoxes = [
  { key: 'privateEquity', ...pillars.privateEquity, href: `#${SECTION_IDS.privateEquity}` },
  { key: 'privateLending', ...pillars.privateLending, href: `#${SECTION_IDS.privateLending}` },
  { key: 'funds', ...pillars.funds, href: `#${SECTION_IDS.funds}` },
]
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{company.tagline}</p>
      <h1 class="hero-title">{company.name}</h1>
      <p class="hero-intro">{company.intro}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#contact">Talk to us</a>
        <a class="btn btn-ghost" href="#offerings">See our offerings</a>
      </div>
    </div>
  </section>

  <section class="section" id="who-we-are">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">About us</p>
        <h2 class="section-title">{whoWeAre.heading || 'Who we are'}</h2>
      </div>
      <div class="who-body">
        {paragraphs(whoWeAre.body).map((p) => (
          <p>{p}</p>
        ))}
      </div>
      {
        whoWeAre.points && whoWeAre.points.length > 0 && (
          <dl class="who-points">
            {whoWeAre.points.map((pt) => (
              <div>
                <dt>{pt.label}</dt>
                <dd>{pt.text}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <section class="section" id="offerings">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we do</p>
        <h2 class="section-title">How we put capital to work</h2>
        {pillars.intro && <p class="section-lede">{pillars.intro}</p>}
      </div>
      <div class="pillars">
        {
          pillarBoxes.map((b) => (
            <a
              class:list={['pillar', { 'is-featured': pillars.emphasis === b.key }]}
              href={b.href}
            >
              <span class="pillar-title">{b.title}</span>
              {b.tagline && <span class="pillar-tagline">{b.tagline}</span>}
              <span class="pillar-more">Learn more →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id={SECTION_IDS.privateLending}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Debt investment</p>
        <h2 class="section-title">{pillars.privateLending.title || 'Private Lending Solutions'}</h2>
        {pillars.privateLending.tagline && (
          <p class="section-lede">{pillars.privateLending.tagline}</p>
        )}
      </div>
      {
        lendingServices.length > 0 && (
          <div class="grid">
            {lendingServices.map((s) => (
              <ServiceCard
                title={s.title}
                icon={s.icon}
                summary={s.summary}
                highlights={s.highlights}
                variant={cardVariant}
                href={`#svc-${s.slug}`}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section band" id={SECTION_IDS.privateEquity}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Late-stage equity</p>
        <h2 class="section-title">{pillars.privateEquity.title || 'Private Equity Investments'}</h2>
      </div>
      <div class="who-body">
        {paragraphs(privateEquity.intro).map((p) => (
          <p>{p}</p>
        ))}
      </div>
      <div class="pe-cols">
        <div>
          <p class="block-label">Current segments of our investments</p>
          {privateEquity.currentSegments && privateEquity.currentSegments.length > 0 ? (
            <ul class="seg-list">
              {privateEquity.currentSegments.map((s) => (
                <li>
                  <strong>{s.name}</strong>
                  {s.note && <span>{s.note}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted-note">To be listed.</p>
          )}
        </div>
        <div>
          <p class="block-label">Target segments we are looking for</p>
          {privateEquity.targetSegments && privateEquity.targetSegments.length > 0 ? (
            <ul class="seg-list">
              {privateEquity.targetSegments.map((s) => (
                <li>
                  <strong>{s.name}</strong>
                  {s.note && <span>{s.note}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted-note">To be listed.</p>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id={SECTION_IDS.funds}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Fund commitments</p>
        <h2 class="section-title">{pillars.funds.title || 'Funds Investments'}</h2>
      </div>
      <div class="who-body">
        {paragraphs(funds.intro).map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="section band" id="no-capital-needed">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Advisory</p>
        <h2 class="section-title">
          {advisory.heading || "No Capital Needed Now? Let's Start Somewhere"}
        </h2>
        {advisory.intro && <p class="section-lede">{advisory.intro}</p>}
      </div>
      {
        advisoryServices.length > 0 && (
          <div class="grid">
            {advisoryServices.map((s) => (
              <ServiceCard
                title={s.title}
                icon={s.icon}
                summary={s.summary}
                highlights={s.highlights}
                variant={cardVariant}
                href={`#svc-${s.slug}`}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>

  {
    appearance.showContact && (
      <section class="section" id="contact">
        <div class="wrap">
          <div class="contact-card">
            <div>
              <p class="eyebrow">Get in touch</p>
              <h2 class="section-title">Let's talk</h2>
              <p class="section-lede">
                Tell us about your business or your capital needs and we'll come back to you.
              </p>
            </div>
            <dl class="details">
              <div>
                <dt>Email</dt>
                <dd>
                  <a href={`mailto:${company.contact.email}`}>{company.contact.email}</a>
                </dd>
              </div>
              <div>
                <dt>Phone</dt>
                <dd>
                  <a href={`tel:${company.contact.phone.replace(/\s+/g, '')}`}>
                    {company.contact.phone}
                  </a>
                </dd>
              </div>
              <div>
                <dt>Office</dt>
                <dd>{company.contact.address}</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>
    )
  }

  {
    /* Detail overlays — hash-addressed panels that open over a blurred page.
       Kept at the end so they sit above everything and add no page scroll. */
  }
  {
    allServices.map((s) => (
      <DetailOverlay
        id={`svc-${s.slug}`}
        eyebrow={s.section === 'advisory' ? 'Advisory' : 'Private lending'}
        title={s.title}
        closeHref={s.section === 'advisory' ? '#no-capital-needed' : `#${SECTION_IDS.privateLending}`}
      >
        <div class="prose">
          {(paragraphs(s.description).length > 0 ? paragraphs(s.description) : [s.summary]).map((p) => (
            <p>{p}</p>
          ))}
        </div>
        {s.regions && s.regions.length > 0 && (
          <div>
            <p class="block-title">Regional coverage</p>
            <ul class="regions">
              {s.regions.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </div>
        )}
        {s.segments && s.segments.length > 0 && (
          <div>
            <p class="block-title">Our Past Engagements</p>
            <ul class="cases">
              {s.segments.map((seg) => (
                <li>
                  <span class="case-name">{seg.name}</span>
                  {seg.examples && seg.examples.length > 0 && (
                    <ul class="example-list">
                      {seg.examples.map((ex) => (
                        <li>{ex}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
        {s.deals && s.deals.length > 0 && (
          <div>
            <p class="block-title">Examples of past successful deals</p>
            <ul class="cases">
              {s.deals.map((d) => (
                <li>
                  <span class="case-name">{d.client}</span>
                  {d.summary && <p class="case-detail">{d.summary}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </DetailOverlay>
    ))
  }
</Base>

<style>
  .hero {
    padding-block: clamp(64px, 11vw, 112px) 40px;
    background: var(--hero-glow);
  }

  /* Advanced setting: drop the wash behind the title. */
  :global(:root[data-hero='flat']) .hero {
    background: none;
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .hero-intro {
    margin-top: 20px;
    max-width: 60ch;
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
    color: var(--ink-secondary);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 20px;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--accent-solid);
    color: var(--on-accent);
  }
  .btn-primary:hover {
    filter: brightness(1.08);
  }

  .btn-ghost {
    border-color: var(--border);
    color: var(--ink);
    background: var(--surface);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
  }

  /* A band of sunken background to separate one section from the next. */
  .band {
    background: var(--surface-sunken);
    border-block: 1px solid var(--border);
  }

  .grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  /* ---------- Who we are ---------- */
  /* The "About us", Private Equity and Funds descriptions are centred. */
  #who-we-are .who-body,
  #private-equity-investments .who-body,
  #funds-investments .who-body {
    margin-inline: auto;
    text-align: center;
  }

  .who-body {
    margin-top: 8px;
    max-width: 65ch;
    display: grid;
    gap: 14px;
    color: var(--ink-secondary);
    font-size: 1.0625rem;
  }

  .who-points {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }
  .who-points div {
    border-top: 2px solid var(--accent);
    padding-top: 12px;
  }
  .who-points dt {
    font-weight: 650;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .who-points dd {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.9375rem;
  }

  /* ---------- Offering boxes ---------- */
  .pillars {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .pillar {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .pillar:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .pillar.is-featured {
    flex: 1.8 1 340px;
    background: var(--accent-wash);
    border-color: transparent;
  }
  .pillar-title {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .pillar.is-featured .pillar-title {
    font-size: 1.375rem;
  }
  .pillar-tagline {
    color: var(--ink-secondary);
    font-size: 0.9375rem;
  }
  .pillar-more {
    margin-top: auto;
    padding-top: 12px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  /* ---------- Private Equity: current / target segments ---------- */
  .pe-cols {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
  }
  .block-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 14px;
  }
  .seg-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .seg-list li {
    display: grid;
    gap: 2px;
    border-left: 2px solid var(--accent);
    padding-left: 14px;
  }
  .seg-list strong {
    color: var(--ink);
    font-weight: 600;
  }
  .seg-list span {
    color: var(--ink-secondary);
    font-size: 0.9375rem;
  }
  .muted-note {
    color: var(--ink-muted);
    font-style: italic;
  }

  /* ---------- Layout: Centred ---------- */
  :global(:root[data-layout='centred']) .hero .wrap,
  :global(:root[data-layout='centred']) .section-head {
    text-align: center;
  }
  :global(:root[data-layout='centred']) .hero-intro,
  :global(:root[data-layout='centred']) .section-lede {
    margin-inline: auto;
  }
  :global(:root[data-layout='centred']) .cta {
    justify-content: center;
  }
  :global(:root[data-layout='centred']) .grid {
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    max-width: 900px;
    margin-inline: auto;
  }

  /* ---------- Layout: List ---------- */
  :global(:root[data-layout='list']) .grid {
    grid-template-columns: 1fr;
    gap: 0;
  }
  /* One hairline between rows rather than a border around each. */
  :global(:root[data-layout='list']) .grid > * + * {
    border-top: 1px solid var(--hairline);
  }

  .contact-card {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 40px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(28px, 5vw, 48px);
  }

  @media (max-width: 820px) {
    .contact-card {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .details {
    display: grid;
    gap: 20px;
    margin: 0;
    align-content: start;
  }

  .details dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .details dd {
    margin: 4px 0 0;
    font-size: 1rem;
    color: var(--ink);
  }
</style>
