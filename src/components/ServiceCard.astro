---
import ServiceIcon from './ServiceIcon.astro'

interface Props {
  title: string
  icon: string
  summary: string
  highlights: string[]
  /* 'row' is the full-width form used by the List layout. */
  variant?: 'card' | 'row'
  /* When set, the whole card becomes a link that opens the detail overlay. */
  href?: string
}
const { title, icon, summary, highlights, variant = 'card', href } = Astro.props
const Tag = href ? 'a' : 'article'
---

<Tag class:list={['card', `is-${variant}`, { 'is-link': href }]} href={href}>
  <span class="icon"><ServiceIcon name={icon} /></span>
  <div class="body">
    <h3 class="title">{title}</h3>
    <p class="summary">{summary}</p>
    {
      highlights.length > 0 && (
        <ul class="highlights">
          {highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }
    {href && <span class="more">View details<span aria-hidden="true"> &rarr;</span></span>}
  </div>
</Tag>

<style>
  .card {
    background: var(--surface);
    border: var(--card-border-width, 1px) solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  /* Card style is an advanced setting; it only ever changes the container,
     never the content inside it. */
  :global(:root[data-card='filled']) .card {
    background: var(--surface-sunken);
    border-color: transparent;
  }
  :global(:root[data-card='plain']) .card {
    background: none;
    border-color: transparent;
    padding-inline: 0;
  }
  :global(:root[data-card='plain']) .card:hover {
    transform: none;
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  /* Linked card: kill the inherited anchor styling, keep it feeling clickable.
     Display is left to .is-card / .is-row so both layouts keep working. */
  a.card.is-link {
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
  }

  .more {
    margin-top: 16px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-text);
  }
  .card.is-link:hover .more {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(:root[data-card='filled']) .card:hover,
  :global(:root[data-card='plain']) .card:hover {
    border-color: transparent;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: var(--radius-sm);
    background: var(--accent-wash);
    color: var(--accent-text);
  }

  .body {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .title {
    font-size: 1.125rem;
  }

  .summary {
    margin-top: 8px;
    /* Pushes .highlights to the bottom so dividers line up across a row even
       when summaries run to different lengths. */
    margin-bottom: auto;
    color: var(--ink-secondary);
    font-size: 0.9375rem;
  }

  .highlights {
    margin: 16px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--hairline);
    list-style: none;
    display: grid;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--ink-secondary);
  }

  .highlights li {
    position: relative;
    padding-left: 18px;
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ---- Card form (Grid and Centred layouts) ---- */
  .is-card {
    display: flex;
    flex-direction: column;
  }
  .is-card .icon {
    margin-bottom: 16px;
  }

  /* ---- Row form (List layout): icon beside the text, highlights inline ---- */
  /* Rows sit flush against each other and are separated by a single hairline
     drawn by the parent, so each row must drop its own box — otherwise the
     borders double up between rows and the rounded corners collide. */
  .card.is-row {
    border: none;
    border-radius: 0;
    padding-inline: 0;
  }
  .card.is-row:hover {
    transform: none;
  }

  .is-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  .is-row .summary {
    margin-bottom: 0;
    max-width: 70ch;
  }
  .is-row .highlights {
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    gap: 24px;
  }

  @media (max-width: 700px) {
    .is-row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .is-row .highlights {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      gap: 8px;
    }
  }
</style>
